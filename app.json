{
  "expo": {
    "name": "EV Range & Radius App",
    "slug": "ev-range-radius-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0B0F16",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon.png"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app requires access to your location to display your EV's position on the map and calculate available driving ranges."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.evrangeradiusapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5b4e24e8-e107-4c6f-a235-3942cc3e9c24"
      }
    },
    "owner": "nuttakornt"
  }
}
