# Copy this file to `.env` and fill in your own key — `.env` is gitignored.

# OpenRouteService API key (free — sign up at https://openrouteservice.org/dev/#/signup,
# no credit card required, 2000 requests/day). Powers the real road-network isochrone
# (drivable-area) polygons shown for safe range / max buffer range on the map. Without this,
# the app falls back to an offline simulated approximation.
EXPO_PUBLIC_ORS_API_KEY=
